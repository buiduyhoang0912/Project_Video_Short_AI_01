# Copy file này thành .env rồi sửa cho đúng máy của bạn:
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# KHÔNG commit file .env lên git (đã có trong .gitignore).

APP_NAME=KS25 Base API

# ---- MySQL ----
# Điền giống thông tin bạn dùng để kết nối trong MySQL Workbench
# (Workbench: chuột phải vào connection -> Edit Connection để xem Hostname/Port/Username).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Mật khẩu root bạn đặt lúc cài MySQL (XAMPP mặc định để trống)
DB_PASSWORD=123456
DB_NAME=app_db

# ---- CORS ----
# Các địa chỉ frontend được phép gọi API, cách nhau bằng dấu phẩy.
# "*" = cho phép tất cả (tiện khi học/dev). Khi deploy thật hãy ghi rõ domain FE.
# Ví dụ: CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=*
FFPROBE_PATH=ffprobe

# Địa chỉ công khai của backend (dùng tạo URL avatar). Đổi khi deploy.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---- JWT ----
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---- AI Chatbot tư vấn mua sắm (Task T3D2476) ----
# Điền GEMINI_API_KEY hoặc OPENAI_API_KEY để gọi AI từ FastAPI.
# AI_PROVIDER: auto (ưu tiên Gemini nếu có key, sau đó OpenAI) | gemini | openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=15
AI_DAILY_QUESTION_LIMIT=20

# ---- Lưu trữ Video & Ảnh Cloudflare R2 (Task T3D2BC7) ----
# STORAGE_DRIVER: local hoặc r2 (mặc định là local)
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
